{
  "name": "alfaglass-facades",
  "productName": "РФ АГМ",
  "version": "0.1.24",
  "private": true,
  "description": "Offline facade configurator for ALFAGLASS managers",
  "author": "ALFAGLASS",
  "main": "main.cjs",
  "scripts": {
    "prepare:app": "node prepare.cjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node test.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ru.alfaglass.facades",
    "productName": "РФ АГМ",
    "directories": {
      "output": "../../.local/facade-desktop-dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "domain.cjs",
      "bundle/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "RF-AGM-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "executableName": "ALFAGLASS Facades"
  }
}